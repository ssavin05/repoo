
:root{
  --red:#c4002b;
  --red-dark:#8f001f;
  --ink:#17171b;
  --ink-2:#25252b;
  --muted:#68686f;
  --line:#e6e6e9;
  --soft:#f5f5f6;
  --white:#fff;
  --radius:18px;
  --shadow:0 24px 70px rgba(20,20,25,.10);
  --container:min(1180px, calc(100% - 40px));
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#fff;line-height:1.6}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit}
.container{width:var(--container);margin-inline:auto}
.skip-link{position:fixed;left:12px;top:-50px;background:#fff;padding:10px 14px;z-index:999;border:1px solid var(--line)}
.skip-link:focus{top:12px}
.topbar{background:var(--ink);color:#fff;font-size:.82rem}
.topbar__inner{min-height:34px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.topbar__links{display:flex;gap:18px;color:#ddd}
.site-header{position:sticky;top:0;background:rgba(255,255,255,.94);backdrop-filter:blur(18px);border-bottom:1px solid rgba(0,0,0,.06);z-index:50}
.header__inner{height:86px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand__logo{width:265px;height:74px;object-fit:contain;object-position:left center}
.nav{display:flex;align-items:center;gap:26px;font-size:.95rem;font-weight:600}
.nav>a:not(.btn){position:relative}
.nav>a:not(.btn)::after{content:"";position:absolute;left:0;right:100%;bottom:-7px;height:2px;background:var(--red);transition:.25s}
.nav>a:hover::after{right:0}
.menu-toggle{display:none;background:none;border:0;width:44px;height:44px;padding:10px}
.menu-toggle span{display:block;height:2px;background:var(--ink);margin:6px 0}
.btn{display:inline-flex;justify-content:center;align-items:center;min-height:50px;padding:0 22px;border:1px solid var(--red);background:var(--red);color:#fff;border-radius:999px;font-weight:750;cursor:pointer;transition:transform .2s,background .2s,box-shadow .2s}
.btn:hover{background:var(--red-dark);transform:translateY(-2px);box-shadow:0 12px 30px rgba(196,0,43,.20)}
.btn--sm{min-height:42px;padding-inline:17px}
.btn--ghost{background:transparent;color:var(--ink);border-color:#cfcfd3}
.btn--ghost:hover{background:#fff;border-color:var(--ink);box-shadow:none}
.btn--light{background:#fff;color:var(--red);border-color:#fff}
.hero{position:relative;overflow:hidden;padding:92px 0 78px;background:linear-gradient(180deg,#fff 0%,#fbfbfc 100%)}
.hero__glow{position:absolute;inset:auto -20% -70% 30%;height:650px;background:radial-gradient(circle,rgba(196,0,43,.11),rgba(196,0,43,0) 62%);pointer-events:none}
.hero__grid{position:relative;display:grid;grid-template-columns:1.25fr .75fr;gap:80px;align-items:center}
.eyebrow{display:inline-block;color:var(--red);font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;font-weight:800;margin-bottom:18px}
.eyebrow--light{color:#ffb9c8}
h1,h2,h3{line-height:1.08;margin:0 0 18px;letter-spacing:-.03em}
h1{font-size:clamp(2.8rem,5.5vw,5.2rem);max-width:880px}
h2{font-size:clamp(2rem,3.5vw,3.55rem)}
h3{font-size:1.35rem}
.hero__content>p{font-size:1.15rem;color:var(--muted);max-width:720px;margin:0 0 30px}
.hero__actions{display:flex;gap:12px;flex-wrap:wrap}
.trust-row{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:44px;padding-top:26px;border-top:1px solid var(--line)}
.trust-row div{display:flex;flex-direction:column}
.trust-row strong{font-size:1rem}
.trust-row span{font-size:.82rem;color:var(--muted)}
.hero__card{background:var(--ink);color:#fff;border-radius:28px;padding:38px;box-shadow:var(--shadow);position:relative;overflow:hidden}
.hero__card::after{content:"CIA";position:absolute;right:-18px;bottom:-44px;font-size:9rem;font-weight:900;color:rgba(255,255,255,.035);line-height:1}
.hero__card-top{display:flex;align-items:center;justify-content:space-between;color:#cfcfd4;font-size:.76rem;letter-spacing:.12em;margin-bottom:34px}
.dot{width:10px;height:10px;background:var(--red);border-radius:50%}
.hero__card h2{font-size:2rem;letter-spacing:-.02em}
.hero__card p{color:#c6c6cc}
.text-link{display:inline-flex;gap:10px;align-items:center;margin-top:14px;font-weight:800;color:#fff}
.section{padding:100px 0}
.section--soft{background:var(--soft)}
.section--dark{background:#151519;color:#fff}
.split{display:grid;grid-template-columns:.9fr 1.1fr;gap:90px}
.section-heading{max-width:760px}
.section-heading--center{text-align:center;margin:0 auto 54px}
.section-heading p{color:var(--muted)}
.intro__copy{font-size:1.12rem;color:#4f4f55}
.intro__copy p:first-child{margin-top:0}
.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.service-card{background:#fff;border:1px solid var(--line);padding:30px;border-radius:var(--radius);min-height:270px;transition:.25s}
.service-card:hover{transform:translateY(-6px);box-shadow:var(--shadow);border-color:#d8d8dc}
.service-card__number{display:inline-flex;width:42px;height:42px;border-radius:50%;background:#fff3f6;color:var(--red);align-items:center;justify-content:center;font-size:.75rem;font-weight:900;margin-bottom:34px}
.service-card p{color:var(--muted);margin-bottom:0}
.profile__grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px;align-items:center}
.profile__photo{position:relative;background:#eee;border-radius:28px;overflow:hidden;min-height:520px}
.profile__photo img{width:100%;height:100%;min-height:520px;object-fit:cover;object-position:center 16%}
.profile__photo-note{position:absolute;left:16px;bottom:16px;background:rgba(20,20,24,.8);color:#fff;padding:8px 12px;border-radius:999px;font-size:.72rem}
.profile__content p{font-size:1.08rem;color:var(--muted);max-width:700px}
.profile__chips{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}
.profile__chips span,.audience__list span{border:1px solid var(--line);padding:10px 14px;border-radius:999px;background:#fff;font-weight:700;font-size:.9rem}
.principles__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:50px}
.principle{padding:32px;border:1px solid #33333a;border-radius:var(--radius);background:#1c1c21}
.principle>span{display:block;color:#ff98ae;font-size:.78rem;text-transform:uppercase;letter-spacing:.13em;font-weight:800;margin-bottom:20px}
.principle p,.principle li{color:#d0d0d4}
.principle ul{columns:2;padding-left:20px;margin:0}
.audience__list{display:flex;justify-content:center;flex-wrap:wrap;gap:12px;max-width:900px;margin:0 auto}
.insights__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:44px}
.insight-card{padding:32px;background:#fff;border-radius:var(--radius);border:1px solid var(--line)}
.insight-card>span{color:var(--red);text-transform:uppercase;letter-spacing:.12em;font-size:.72rem;font-weight:800}
.insight-card h3{margin-top:20px}
.insight-card p{color:var(--muted);margin-bottom:0}
.cta{padding-top:0;background:var(--soft)}
.cta__box{background:linear-gradient(135deg,#9b001f,#d00735);color:#fff;border-radius:30px;padding:54px;display:flex;align-items:end;justify-content:space-between;gap:40px;box-shadow:0 30px 70px rgba(150,0,30,.18)}
.cta__box h2{max-width:760px}
.cta__box p{color:#ffdbe3;max-width:650px;margin-bottom:0}
.contact__grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px}
.contact__info>p{color:var(--muted);font-size:1.05rem}
.contact-list{margin-top:34px}
.contact-list div{display:grid;grid-template-columns:110px 1fr;gap:20px;padding:16px 0;border-bottom:1px solid var(--line)}
.contact-list dt{font-weight:800}
.contact-list dd{margin:0;color:var(--muted)}
.contact-form{border:1px solid var(--line);padding:34px;border-radius:24px;box-shadow:0 18px 55px rgba(20,20,25,.06)}
.contact-form label{display:block;font-size:.86rem;font-weight:750;margin-bottom:16px}
.contact-form input,.contact-form select,.contact-form textarea{width:100%;margin-top:7px;border:1px solid #d9d9dd;border-radius:12px;padding:13px 14px;background:#fff;outline:none;transition:border .2s,box-shadow .2s}
.contact-form input:focus,.contact-form select:focus,.contact-form textarea:focus{border-color:var(--red);box-shadow:0 0 0 4px rgba(196,0,43,.08)}
.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.form-note{font-size:.8rem;color:var(--muted);margin:12px 0 0}
.footer{background:#111115;color:#fff;padding:60px 0 46px}
.footer__grid{display:grid;grid-template-columns:1.4fr .7fr .7fr;gap:50px}
.footer__grid>div{display:flex;flex-direction:column;align-items:flex-start;gap:10px}
.footer__grid p,.footer__grid a,.footer__grid span{color:#bdbdc4;font-size:.9rem}
.footer__logo{width:240px;height:72px;object-fit:contain;object-position:left;background:#fff;border-radius:8px}
.whatsapp-float{position:fixed;right:20px;bottom:20px;width:58px;height:58px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#111;color:#fff;font-weight:900;box-shadow:0 14px 30px rgba(0,0,0,.25);z-index:40;border:2px solid #fff}
.privacy{max-width:600px;border:0;border-radius:20px;padding:34px;box-shadow:var(--shadow)}
.privacy::backdrop{background:rgba(0,0,0,.55)}
.privacy__close{position:absolute;right:18px;top:14px;border:0;background:none;font-size:2rem;cursor:pointer}
.reveal{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s ease}
.reveal.visible{opacity:1;transform:none}
.reveal--delay{transition-delay:.12s}
@media (max-width:980px){
  .topbar__inner>span{display:none}.topbar__inner{justify-content:flex-end}
  .header__inner{height:76px}.brand__logo{width:220px;height:62px}
  .menu-toggle{display:block}.nav{position:absolute;left:20px;right:20px;top:86px;display:none;flex-direction:column;align-items:stretch;background:#fff;border:1px solid var(--line);border-radius:18px;padding:18px;box-shadow:var(--shadow)}.nav.open{display:flex}.nav .btn{width:100%}
  .hero{padding-top:70px}.hero__grid,.split,.profile__grid,.contact__grid{grid-template-columns:1fr;gap:48px}.hero__card{max-width:640px}.service-grid,.principles__grid,.insights__grid{grid-template-columns:repeat(2,1fr)}
  .cta__box{align-items:flex-start;flex-direction:column}
  .footer__grid{grid-template-columns:1fr 1fr}.footer__grid>div:first-child{grid-column:1/-1}
}
@media (max-width:640px){
  :root{--container:min(100% - 28px,1180px)}
  .topbar{display:none}.header__inner{height:72px}.brand__logo{width:188px;height:58px}.nav{top:78px;left:14px;right:14px}
  .hero{padding:54px 0 44px}.hero__grid{gap:36px}.hero__content>p{font-size:1rem}.hero__actions{display:grid}.btn{width:100%}
  .trust-row{grid-template-columns:1fr;gap:10px}.trust-row div{padding-bottom:8px}
  .hero__card{padding:26px}.hero__card h2{font-size:1.65rem}
  .section{padding:72px 0}.section-heading--center{margin-bottom:36px}
  .service-grid,.principles__grid,.insights__grid{grid-template-columns:1fr}.service-card{min-height:auto}
  .profile__photo,.profile__photo img{min-height:420px}
  .principle ul{columns:1}
  .cta__box{padding:32px 24px;border-radius:22px}
  .contact-form{padding:24px}.field-grid{grid-template-columns:1fr}
  .contact-list div{grid-template-columns:1fr;gap:2px}
  .footer__grid{grid-template-columns:1fr}.footer__grid>div:first-child{grid-column:auto}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal{opacity:1;transform:none;transition:none}.btn,.service-card{transition:none}}
.btn--dark{background:var(--ink);border-color:var(--ink)}
.btn--dark:hover{background:#000;border-color:#000}
.service-card details{margin-top:22px;border-top:1px solid var(--line);padding-top:16px}
.service-card summary{cursor:pointer;color:var(--red);font-weight:800;font-size:.9rem}
.service-card details ul{padding-left:20px;color:var(--muted);font-size:.9rem}
.service-card details p{font-size:.9rem}
.why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.why-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:30px}
.why-card>strong{display:block;color:var(--red);font-size:2.4rem;line-height:1;margin-bottom:28px;letter-spacing:-.05em}
.why-card p{color:var(--muted);margin-bottom:0}
.optional-contact[hidden]{display:none}
.consent{display:flex!important;align-items:flex-start;gap:9px;font-weight:500!important;color:var(--muted)}
.consent input{width:auto!important;margin:4px 0 0!important}
.whatsapp-float{width:auto;min-width:58px;padding:0 17px;gap:8px;border-radius:999px;background:#17171b}
.whatsapp-float svg{width:23px;height:23px;fill:#fff}
.whatsapp-float span{font-size:.82rem}
.mobile-actions{display:none}
@media(max-width:980px){.why-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.why-grid{grid-template-columns:1fr}.whatsapp-float{display:none}.mobile-actions{display:grid;grid-template-columns:1fr 1fr;position:fixed;left:0;right:0;bottom:0;z-index:60;background:#fff;border-top:1px solid var(--line);padding:8px 12px calc(8px + env(safe-area-inset-bottom));gap:8px;box-shadow:0 -8px 25px rgba(0,0,0,.08)}.mobile-actions a{display:flex;align-items:center;justify-content:center;min-height:46px;border-radius:999px;font-weight:800;border:1px solid var(--ink)}.mobile-actions a:last-child{background:var(--ink);color:#fff}.footer{padding-bottom:110px}}

/* V3 - agrupación de servicios */
.service-groups{display:grid;gap:42px}.service-group__heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin:0 0 20px;padding-bottom:14px;border-bottom:1px solid rgba(16,18,20,.14)}.service-group__heading span{font-size:1.05rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.service-group__heading p{max-width:620px;margin:0;color:var(--muted,#666);text-align:right}.service-group--secondary{margin-top:4px}@media(max-width:760px){.service-group__heading{display:block}.service-group__heading p{margin-top:8px;text-align:left}}

/* Historia */
.history{overflow:hidden}
.history__hero{display:grid;grid-template-columns:.9fr 1.1fr;gap:90px;align-items:start}
.history__hero h2{max-width:620px}
.history__lead{font-size:1.12rem;color:#4f4f55}
.history__lead p:first-child{margin-top:0}
.history__statement{margin:64px 0 42px;padding:34px 38px;border-left:4px solid var(--accent);background:#f6f6f7;display:grid;grid-template-columns:.65fr 1.35fr;gap:44px;align-items:center}
.history__statement span{font-size:1.35rem;font-weight:800;line-height:1.2;color:var(--text)}
.history__statement p{margin:0;color:var(--muted)}
.history__timeline{border-top:1px solid #d9d9dc}
.history__milestone{display:grid;grid-template-columns:150px 1fr;gap:42px;padding:34px 0;border-bottom:1px solid #d9d9dc}
.history__year{font-size:2.15rem;font-weight:900;letter-spacing:-.05em;color:var(--accent)}
.history__milestone h3{margin:0 0 8px;font-size:1.3rem}
.history__milestone p{margin:0;max-width:760px;color:var(--muted)}

@media (max-width: 820px){.history__hero,.history__statement{grid-template-columns:1fr;gap:26px}.history__statement{margin:44px 0 28px;padding:28px}.history__milestone{grid-template-columns:86px 1fr;gap:22px}.history__year{font-size:1.55rem}}
@media (max-width: 520px){.history__milestone{grid-template-columns:1fr;gap:8px;padding:26px 0}}

/* V9 — Motion system inspirado en la referencia aprobada */
.scroll-progress{position:fixed;top:0;left:0;right:0;height:3px;z-index:1000;pointer-events:none;background:transparent}.scroll-progress span{display:block;height:100%;width:0;background:var(--red);box-shadow:0 0 16px rgba(185,0,40,.55)}
.site-header{transition:transform .35s ease,background .35s ease,box-shadow .35s ease,backdrop-filter .35s ease}.site-header.is-scrolled{background:rgba(255,255,255,.88);backdrop-filter:blur(16px);box-shadow:0 12px 30px rgba(20,20,25,.08)}.site-header.is-scrolled .header__inner{height:70px}.header__inner{transition:height .35s ease}
.nav a{position:relative}.nav a:not(.btn)::after{content:"";position:absolute;left:0;right:100%;bottom:-8px;height:2px;background:var(--red);transition:right .3s ease}.nav a.active:not(.btn)::after,.nav a:hover:not(.btn)::after{right:0}
.hero{position:relative;overflow:hidden}.hero__grid-lines{position:absolute;inset:0;pointer-events:none;opacity:.35;background-image:linear-gradient(rgba(185,0,40,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(185,0,40,.045) 1px,transparent 1px);background-size:52px 52px;mask-image:linear-gradient(to bottom,#000,transparent 78%)}.hero__monogram{position:absolute;right:-2vw;top:46%;transform:translateY(-50%);font-size:clamp(10rem,25vw,28rem);font-weight:900;letter-spacing:-.09em;color:rgba(185,0,40,.035);user-select:none;pointer-events:none;animation:monogramFloat 10s ease-in-out infinite}.hero__glow{animation:glowPulse 7s ease-in-out infinite}
.hero__content .eyebrow,.hero__content h1,.hero__content>p,.hero__actions,.trust-row{animation:heroEnter .85s cubic-bezier(.2,.7,.2,1) both}.hero__content h1{animation-delay:.08s}.hero__content>p{animation-delay:.16s}.hero__actions{animation-delay:.24s}.trust-row{animation-delay:.32s}
.hero__card{transform-style:preserve-3d;will-change:transform;transition:transform .18s ease-out,box-shadow .35s ease;overflow:hidden}.hero__card:hover{box-shadow:0 30px 80px rgba(20,20,25,.16)}.hero__card-orbit{position:absolute;border:1px solid rgba(185,0,40,.18);border-radius:50%;pointer-events:none}.hero__card-orbit--one{width:180px;height:180px;right:-70px;top:-70px;animation:orbitSpin 12s linear infinite}.hero__card-orbit--two{width:110px;height:110px;right:-18px;top:-20px;animation:orbitSpin 8s linear infinite reverse}
.scroll-cue{position:absolute;left:50%;bottom:24px;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;font-size:.72rem;text-transform:uppercase;letter-spacing:.16em;font-weight:800;color:var(--muted);z-index:3}.scroll-cue i{width:1px;height:34px;background:linear-gradient(var(--red),transparent);animation:scrollCue 1.8s ease-in-out infinite}
.reveal{opacity:0;transform:translateY(28px) scale(.985);filter:blur(4px);transition:opacity .75s cubic-bezier(.2,.7,.2,1),transform .75s cubic-bezier(.2,.7,.2,1),filter .75s ease}.reveal.visible{opacity:1;transform:none;filter:none}.reveal:nth-child(2){transition-delay:.06s}.reveal:nth-child(3){transition-delay:.12s}.reveal:nth-child(4){transition-delay:.18s}.reveal:nth-child(5){transition-delay:.24s}
.tilt-card{position:relative;will-change:transform;transition:transform .18s ease-out,box-shadow .3s ease,border-color .3s ease}.tilt-card::before{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;background:radial-gradient(360px circle at var(--mx,50%) var(--my,50%),rgba(185,0,40,.09),transparent 44%);opacity:0;transition:opacity .25s ease}.tilt-card:hover::before{opacity:1}.tilt-card:hover{border-color:rgba(185,0,40,.25);box-shadow:0 22px 50px rgba(20,20,25,.08)}
.service-card__number{display:inline-block;transition:transform .3s ease,color .3s ease}.service-card:hover .service-card__number{transform:translateY(-4px) scale(1.05);color:var(--red)}
.history__milestone{position:relative}.history__milestone::before{content:"";position:absolute;left:0;bottom:-1px;width:0;height:1px;background:var(--red);transition:width .65s ease}.history__milestone.visible::before{width:100%}.history__year{display:inline-block;transition:transform .35s ease}.history__milestone:hover .history__year{transform:translateX(8px)}
.principle,.insight-card,.why-card{overflow:hidden}
.back-to-top{position:fixed;right:22px;bottom:92px;width:44px;height:44px;border:1px solid var(--line);border-radius:50%;background:rgba(255,255,255,.94);backdrop-filter:blur(10px);display:grid;place-items:center;z-index:55;opacity:0;transform:translateY(10px);pointer-events:none;transition:opacity .25s ease,transform .25s ease,background .25s ease}.back-to-top.visible{opacity:1;transform:none;pointer-events:auto}.back-to-top:hover{background:var(--ink);color:#fff}.back-to-top svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2}
@keyframes heroEnter{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}@keyframes monogramFloat{0%,100%{transform:translateY(-50%) translateX(0)}50%{transform:translateY(-53%) translateX(-14px)}}@keyframes glowPulse{0%,100%{opacity:.65;transform:scale(1)}50%{opacity:1;transform:scale(1.08)}}@keyframes orbitSpin{to{transform:rotate(360deg)}}@keyframes scrollCue{0%,100%{transform:scaleY(.45);transform-origin:top;opacity:.45}50%{transform:scaleY(1);opacity:1}}
@media(max-width:980px){.scroll-cue{display:none}.hero__monogram{font-size:42vw;right:-10vw}.site-header.is-scrolled .header__inner{height:66px}}
@media(max-width:640px){.back-to-top{bottom:78px;right:14px}.hero__grid-lines{background-size:34px 34px}.hero__monogram{top:34%;opacity:.75}.tilt-card{transform:none!important}}
@media(prefers-reduced-motion:reduce){.hero__monogram,.hero__glow,.hero__content .eyebrow,.hero__content h1,.hero__content>p,.hero__actions,.trust-row,.hero__card-orbit,.scroll-cue i{animation:none!important}.reveal{opacity:1;transform:none;filter:none;transition:none}.tilt-card{transform:none!important;transition:none}.history__milestone::before{width:100%;transition:none}}

/* =========================================================
   V10 — Dirección de arte premium
   ========================================================= */
:root{
  --red:#b20b32;
  --red-2:#d31847;
  --ink:#111216;
  --ink-2:#1b1d23;
  --paper:#f4f2ef;
  --warm:#ebe7e2;
  --line:rgba(17,18,22,.11);
  --muted:#676870;
  --shadow-lg:0 28px 90px rgba(17,18,22,.12);
  --radius-lg:34px;
}
body{background:#fbfbfa;color:var(--ink);text-rendering:optimizeLegibility}
.container{width:min(1180px,calc(100% - 48px))}
.section{padding:clamp(84px,9vw,138px) 0}
.section-heading h2,.history__hero h2,.profile__content h2,.contact__info h2,.cta__box h2{letter-spacing:-.045em}
.eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:.72rem;letter-spacing:.17em;text-transform:uppercase;font-weight:900}
.eyebrow::before{content:"";width:28px;height:2px;background:currentColor;opacity:.85}

/* Navigation */
.topbar{background:var(--ink);color:rgba(255,255,255,.72);border:0}
.topbar__inner{min-height:35px;font-size:.72rem;letter-spacing:.035em}
.site-header{border-bottom:1px solid rgba(17,18,22,.06);background:rgba(251,251,250,.93)}
.header__inner{height:84px}
.brand__logo{max-height:54px;filter:saturate(.92) contrast(1.03)}
.nav{gap:25px}.nav a{font-size:.82rem;font-weight:750}.nav .btn{padding:12px 18px}

/* Hero */
.hero{min-height:min(860px,calc(100svh - 35px));display:flex;align-items:center;background:
 radial-gradient(circle at 80% 25%,rgba(178,11,50,.16),transparent 27%),
 linear-gradient(120deg,#fbfaf8 0%,#f5f1ee 48%,#eee9e5 100%)}
.hero::before{content:"";position:absolute;left:0;bottom:0;width:42%;height:1px;background:linear-gradient(90deg,var(--red),transparent)}
.hero__grid{grid-template-columns:minmax(0,1.15fr) minmax(360px,.7fr);gap:clamp(42px,7vw,92px);padding-top:65px;padding-bottom:76px}
.hero__content{position:relative;z-index:3}
.hero__content h1{font-size:clamp(3.25rem,6.3vw,6.85rem);line-height:.92;max-width:870px;margin:.26em 0 .34em;letter-spacing:-.075em}
.hero__content>p{max-width:740px;font-size:clamp(1.05rem,1.5vw,1.28rem);line-height:1.7;color:#52545b}
.hero__actions{gap:10px;margin-top:34px}.btn{border-radius:999px;min-height:50px;padding:13px 22px;box-shadow:none}.btn:hover{transform:translateY(-2px)}
.btn--ghost{background:rgba(255,255,255,.52);backdrop-filter:blur(10px)}
.trust-row{margin-top:48px;padding:22px 0 0;border-top:1px solid rgba(17,18,22,.13);gap:0;max-width:780px}
.trust-row>div{padding:0 25px;border-right:1px solid rgba(17,18,22,.1)}.trust-row>div:first-child{padding-left:0}.trust-row>div:last-child{border:0}
.trust-row strong{font-size:1.15rem}.trust-row span{font-size:.76rem}
.expertise-rail{display:flex;align-items:center;gap:14px;margin-top:24px;font-size:.7rem;text-transform:uppercase;letter-spacing:.11em;font-weight:850;color:#6a6870;flex-wrap:wrap}
.expertise-rail i{width:4px;height:4px;border-radius:50%;background:var(--red)}
.hero__card{min-height:470px;padding:34px;display:flex;flex-direction:column;justify-content:flex-end;border:1px solid rgba(255,255,255,.14);border-radius:38px;color:#fff;background:
 linear-gradient(180deg,rgba(255,255,255,.02),rgba(255,255,255,.08)),
 radial-gradient(circle at 90% 10%,rgba(211,24,71,.42),transparent 30%),
 var(--ink);box-shadow:0 34px 90px rgba(17,18,22,.22)}
.hero__card::after{content:"CIA";position:absolute;top:20%;left:-5%;font-size:9rem;font-weight:950;letter-spacing:-.12em;color:rgba(255,255,255,.045);transform:rotate(-90deg)}
.hero__card-top{position:absolute;top:31px;left:34px;right:34px;color:rgba(255,255,255,.62)}
.hero__card h2{font-size:clamp(2rem,3vw,3rem);line-height:1.02;letter-spacing:-.055em;max-width:480px;position:relative;z-index:2}
.hero__card p{color:rgba(255,255,255,.7);max-width:470px;position:relative;z-index:2}.hero__card .text-link{color:#fff;position:relative;z-index:2}
.hero__card .dot{box-shadow:0 0 0 8px rgba(211,24,71,.12)}
.hero__monogram{color:rgba(178,11,50,.028)}

/* History editorial layout */
.history{background:#fff}
.history__hero{grid-template-columns:.82fr 1.18fr;gap:clamp(50px,9vw,120px)}
.history__hero h2{font-size:clamp(2.8rem,5vw,5.4rem);line-height:.98}
.history__lead{border-left:1px solid var(--line);padding-left:40px}
.history__statement{border:0;border-radius:28px;padding:48px 52px;background:var(--ink);color:#fff;box-shadow:var(--shadow-lg)}
.history__statement span{color:#fff;font-size:clamp(1.5rem,2.6vw,2.3rem);letter-spacing:-.04em}.history__statement p{color:rgba(255,255,255,.64);font-size:1.04rem}
.history__timeline{border-top:0;display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}
.history__milestone{display:block;border:1px solid var(--line);border-radius:24px;padding:31px;min-height:260px;background:#fbfbfa}
.history__milestone::before{height:3px;bottom:auto;top:-1px;border-radius:5px}.history__year{font-size:clamp(2.2rem,4vw,3.5rem);margin-bottom:45px}.history__milestone p{font-size:.92rem}

/* Services: less template, more editorial */
.services{background:var(--paper)}
.services .section-heading{max-width:900px;margin-inline:auto;margin-bottom:62px}.services .section-heading h2{font-size:clamp(2.7rem,4.7vw,5rem);line-height:1}
/* removed: old asymmetric service grid */
/* removed: old asymmetric service card */
/* removed: old wide cards */
/* removed: old dark cards */
.service-card::after{content:"";position:absolute;width:120px;height:120px;border:1px solid rgba(178,11,50,.12);border-radius:50%;top:-58px;right:-44px;transition:transform .6s ease,background .35s ease}
.service-card:hover::after{transform:scale(1.35);background:rgba(178,11,50,.045)}
.service-card__number{position:absolute;top:26px;left:27px;font-size:.74rem;letter-spacing:.12em;font-weight:900;color:var(--red)}
.service-card h3{font-size:clamp(1.35rem,2vw,1.78rem);line-height:1.06;letter-spacing:-.035em;margin:0 0 13px}.service-card p{margin:0;max-width:430px;color:#686970;line-height:1.55}
.service-group--secondary{margin-top:56px;padding-top:50px;border-top:1px solid rgba(17,18,22,.13)}
.service-group--secondary .service-grid{grid-template-columns:repeat(3,1fr)}.service-group--secondary .service-card{grid-column:auto!important;min-height:230px;background:#fff;color:var(--ink)}

/* Profile */
.profile{background:var(--ink);color:#fff;overflow:hidden}.profile::before{content:"CIA";position:absolute;right:-3vw;bottom:-10vw;font-size:30vw;line-height:.8;font-weight:950;letter-spacing:-.12em;color:rgba(255,255,255,.018);pointer-events:none}
.profile__grid{gap:clamp(50px,8vw,105px)}.profile__photo{border-radius:34px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.32);transform:rotate(-1deg)}.profile__photo img{filter:grayscale(.1) contrast(1.03)}
.profile__content .eyebrow{color:#ff6687}.profile__content h2{font-size:clamp(2.8rem,5vw,5rem);line-height:.98}.profile__content p{color:rgba(255,255,255,.66);font-size:1.08rem}.profile__chips span{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);color:#fff}

/* Why */
.why{background:#fff}.why-grid{gap:13px}.why-card{border-radius:23px;min-height:280px;padding:30px;background:#f7f6f4}.why-card:first-child{background:var(--red);color:#fff}.why-card:first-child>strong,.why-card:first-child p{color:#fff}.why-card>strong{font-size:clamp(2rem,3vw,3rem)}

/* Principles */
.principles{background:linear-gradient(135deg,#101115,#1a1b21)}.principles .section-heading{max-width:800px}.principles .section-heading h2{font-size:clamp(2.8rem,5vw,5rem);line-height:1}
.principles__grid{gap:14px}.principle{border:1px solid rgba(255,255,255,.1);border-radius:26px;background:rgba(255,255,255,.045);padding:34px;min-height:310px}.principle>span{font-size:.75rem;letter-spacing:.16em;text-transform:uppercase;color:#ff6687}.principle p,.principle li{color:rgba(255,255,255,.66)}

/* Collaborations / partners placeholders intentionally designed */
#colaboraciones{background:#fff}#socios{background:var(--paper)}
.showcase-panel{display:grid;grid-template-columns:1.1fr .9fr;gap:70px;align-items:stretch;border:1px solid var(--line);border-radius:34px;padding:clamp(32px,5vw,68px);background:#fff;box-shadow:0 18px 70px rgba(17,18,22,.055)}
.showcase-panel--reverse{grid-template-columns:.9fr 1.1fr}.showcase-panel--reverse .showcase-panel__copy{order:2}.showcase-panel--reverse .showcase-panel__visual{order:1;background:var(--red)}
.showcase-panel__copy{align-self:center}.showcase-panel__copy h2{font-size:clamp(2.4rem,4vw,4.2rem);line-height:1;letter-spacing:-.05em}.showcase-panel__copy p{max-width:640px;color:var(--muted);font-size:1.05rem}
.showcase-panel__visual{min-height:310px;border-radius:25px;background:var(--ink);color:#fff;position:relative;overflow:hidden;padding:30px;display:flex;align-items:flex-end;justify-content:space-between}
.showcase-panel__visual::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 80% 15%,rgba(255,255,255,.18),transparent 25%),linear-gradient(135deg,transparent,rgba(255,255,255,.04))}.showcase-mark{position:absolute;right:-20px;top:-35px;font-size:15rem;font-weight:950;line-height:1;color:rgba(255,255,255,.08)}
.showcase-panel__visual div{position:relative;z-index:2}.showcase-panel__visual b,.showcase-panel__visual small{display:block}.showcase-panel__visual b{font-size:1.18rem}.showcase-panel__visual small{margin-top:6px;color:rgba(255,255,255,.55)}

/* Insights */
.insights{background:#fff!important}.insights__grid{gap:14px}.insight-card{border-radius:25px;min-height:270px;padding:30px;background:#f6f5f3;border:0}.insight-card:nth-child(2){background:#eee9e5}.insight-card span{color:var(--red);font-size:.72rem;text-transform:uppercase;letter-spacing:.14em;font-weight:900}

/* CTA */
.cta{position:relative;background:var(--paper);overflow:hidden}.cta__box{border-radius:38px;padding:clamp(42px,7vw,78px);background:var(--red);box-shadow:0 30px 90px rgba(178,11,50,.2);position:relative;overflow:hidden}.cta__box::after{content:"CIA";position:absolute;right:-1.2rem;bottom:-3.8rem;font-size:12rem;font-weight:950;letter-spacing:-.12em;color:rgba(255,255,255,.08)}.cta__box>*{position:relative;z-index:2}.cta__box h2{font-size:clamp(2.8rem,5vw,5rem);line-height:.96;max-width:760px}.cta__box p{color:rgba(255,255,255,.78)}

/* Contact */
.contact{background:#fff}.contact__grid{grid-template-columns:.8fr 1.2fr;gap:clamp(55px,8vw,110px)}.contact__info h2{font-size:clamp(3rem,5vw,5rem)}.contact-form{background:#f5f3f0;border:1px solid var(--line);border-radius:30px;padding:clamp(28px,4vw,48px);box-shadow:0 24px 70px rgba(17,18,22,.06)}
.contact-form input,.contact-form select,.contact-form textarea{background:#fff;border:1px solid rgba(17,18,22,.12);border-radius:15px;min-height:50px;transition:border .2s ease,box-shadow .2s ease}.contact-form textarea{min-height:138px}.contact-form input:focus,.contact-form select:focus,.contact-form textarea:focus{outline:0;border-color:rgba(178,11,50,.5);box-shadow:0 0 0 4px rgba(178,11,50,.08)}
.footer{background:#0c0d10;border-top:0;color:#fff}.footer a,.footer p,.footer span{color:rgba(255,255,255,.55)}

/* Responsive */
@media(max-width:980px){
  .hero{min-height:auto}.hero__grid{grid-template-columns:1fr;padding-top:65px}.hero__card{min-height:360px}.hero__content h1{font-size:clamp(3.1rem,10vw,5.7rem)}
  .history__timeline{grid-template-columns:1fr}.history__milestone{min-height:0}
  .service-card,.service-card:nth-child(n){grid-column:span 6!important;min-height:260px}
  .showcase-panel,.showcase-panel--reverse{grid-template-columns:1fr;gap:30px}.showcase-panel--reverse .showcase-panel__copy,.showcase-panel--reverse .showcase-panel__visual{order:initial}
}
@media(max-width:700px){
  .container{width:min(100% - 28px,1180px)}.section{padding:74px 0}
  .topbar{display:none}.hero__grid{padding-top:45px}.hero__content h1{font-size:clamp(3rem,15vw,4.7rem)}.hero__actions{display:grid}.hero__actions .btn{width:100%}.trust-row{display:grid;grid-template-columns:1fr 1fr}.trust-row>div{padding:0 14px 15px 0;border-right:0}.trust-row>div:last-child{grid-column:1/-1;border-top:1px solid var(--line);padding-top:15px}.expertise-rail{gap:9px;font-size:.61rem}
  .history__lead{border:0;padding-left:0}.history__statement{padding:30px;grid-template-columns:1fr}.history__timeline{gap:10px}
  .service-grid{grid-template-columns:1fr}.service-card,.service-card:nth-child(n){grid-column:1/-1!important;min-height:225px}.service-group--secondary .service-grid{grid-template-columns:1fr}
  .why-grid,.principles__grid{grid-template-columns:1fr}.why-card,.principle{min-height:230px}
  .showcase-panel{padding:26px;border-radius:25px}.showcase-panel__visual{min-height:230px}.showcase-mark{font-size:11rem}
  .contact__grid{grid-template-columns:1fr}.contact-form{padding:24px;border-radius:24px}
}


/* V12 — Servicios principales uniformes */
#servicios .service-group:not(.service-group--secondary) .service-grid {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: 18px !important;
}
#servicios .service-group:not(.service-group--secondary) .service-card,
#servicios .service-group:not(.service-group--secondary) .service-card:nth-child(n) {
  grid-column: auto !important;
  min-height: 270px !important;
  background: #fff !important;
  color: var(--ink) !important;
  border: 1px solid var(--line) !important;
  border-radius: var(--radius) !important;
  padding: 30px !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: flex-start !important;
  position: relative !important;
  overflow: hidden !important;
  backdrop-filter: none !important;
}
#servicios .service-group:not(.service-group--secondary) .service-card::after {
  display: none !important;
}
#servicios .service-group:not(.service-group--secondary) .service-card__number {
  position: static !important;
  display: inline-flex !important;
  flex: 0 0 auto !important;
  width: 42px !important;
  height: 42px !important;
  border-radius: 50% !important;
  background: #fff3f6 !important;
  color: var(--red) !important;
  align-items: center !important;
  justify-content: center !important;
  font-size: .75rem !important;
  letter-spacing: normal !important;
  font-weight: 900 !important;
  margin: 0 0 34px !important;
}
#servicios .service-group:not(.service-group--secondary) .service-card h3 {
  color: var(--ink) !important;
  font-size: 1.55rem !important;
  line-height: 1.15 !important;
  letter-spacing: -.025em !important;
  margin: auto 0 12px !important;
}
#servicios .service-group:not(.service-group--secondary) .service-card p,
#servicios .service-group:not(.service-group--secondary) .service-card:nth-child(n) p {
  color: var(--muted) !important;
  margin: 0 !important;
  line-height: 1.6 !important;
}
#servicios .service-group:not(.service-group--secondary) .service-card:hover {
  transform: translateY(-6px) !important;
  box-shadow: var(--shadow) !important;
  border-color: #d8d8dc !important;
}
@media (max-width: 980px) {
  #servicios .service-group:not(.service-group--secondary) .service-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
}
@media (max-width: 680px) {
  #servicios .service-group:not(.service-group--secondary) .service-grid {
    grid-template-columns: 1fr !important;
  }
  #servicios .service-group:not(.service-group--secondary) .service-card,
  #servicios .service-group:not(.service-group--secondary) .service-card:nth-child(n) {
    min-height: 230px !important;
  }
}

/* =========================================================
   V13 — Responsive universal: escritorio, laptop, tablet y móvil
   ========================================================= */
html,body{max-width:100%;overflow-x:hidden}
body{min-width:320px}
img,svg,video,canvas{max-width:100%;height:auto}
input,select,textarea,button{max-width:100%}
.container{width:min(1180px,calc(100% - clamp(28px,5vw,64px)))!important}

/* Evita que textos largos rompan columnas */
h1,h2,h3,p,a,span,li,dd{overflow-wrap:anywhere}

/* Tipografía realmente fluida */
.hero__content h1{font-size:clamp(2.45rem,6.2vw,6.85rem)!important}
.section-heading h2,.history__hero h2,.profile__content h2,.contact__info h2,.cta__box h2{font-size:clamp(2rem,4.3vw,5rem)!important}

/* Cabecera: nunca fuerza desbordamiento */
.header__inner{min-width:0}
.brand{min-width:0;flex:0 1 auto}
.brand__logo{width:clamp(170px,18vw,265px)!important;height:auto!important;max-height:60px!important}
.nav{min-width:0;gap:clamp(12px,1.5vw,25px)!important}
.nav a{white-space:nowrap}

/* Hero */
.hero__grid{grid-template-columns:minmax(0,1.15fr) minmax(300px,.7fr)!important;gap:clamp(32px,6vw,88px)!important}
.hero__content,.hero__card{min-width:0}
.trust-row{grid-template-columns:repeat(3,minmax(0,1fr))!important}

/* Grids generales */
.service-grid,.principles__grid,.insights__grid,.why-grid{min-width:0}
.service-card,.principle,.insight-card,.why-card{min-width:0}
.field-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
.footer__grid{grid-template-columns:minmax(0,1.4fr) minmax(140px,.7fr) minmax(140px,.7fr)}

/* Pantallas medianas / laptops angostas */
@media (max-width:1180px){
  .nav{gap:14px!important}.nav a{font-size:.76rem!important}.nav .btn{padding-inline:14px!important}
  .hero__grid{grid-template-columns:minmax(0,1fr) minmax(300px,.72fr)!important}
  .profile__grid,.contact__grid{gap:clamp(38px,5vw,70px)!important}
}

/* Tablet horizontal y laptops pequeñas */
@media (max-width:1024px){
  .topbar__inner>span{display:none!important}.topbar__inner{justify-content:flex-end!important}
  .menu-toggle{display:block!important;flex:0 0 44px}
  .nav{position:absolute!important;left:clamp(14px,3vw,28px)!important;right:clamp(14px,3vw,28px)!important;top:calc(100% + 8px)!important;display:none!important;flex-direction:column!important;align-items:stretch!important;gap:4px!important;background:rgba(255,255,255,.98)!important;border:1px solid var(--line)!important;border-radius:20px!important;padding:14px!important;box-shadow:var(--shadow-lg)!important;max-height:calc(100dvh - 110px)!important;overflow:auto!important}
  .nav.open{display:flex!important}.nav a{white-space:normal!important;font-size:.92rem!important;padding:10px 12px!important}.nav .btn{width:100%!important}
  .hero{min-height:auto!important}.hero__grid{grid-template-columns:1fr!important;padding-top:clamp(38px,6vw,62px)!important;padding-bottom:clamp(55px,8vw,80px)!important}.hero__card{min-height:330px!important}
  .split,.profile__grid,.contact__grid{grid-template-columns:1fr!important;gap:clamp(34px,6vw,52px)!important}
  .profile__photo{min-height:min(62vw,560px)!important}.profile__photo img{min-height:min(62vw,560px)!important}
  .showcase-panel,.showcase-panel--reverse{grid-template-columns:1fr!important}.showcase-panel--reverse .showcase-panel__copy,.showcase-panel--reverse .showcase-panel__visual{order:initial!important}
  .footer__grid{grid-template-columns:1.25fr 1fr 1fr!important;gap:30px!important}
}

/* Tablet vertical */
@media (max-width:820px){
  .section{padding:clamp(68px,10vw,94px) 0!important}
  .trust-row{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:0!important}
  #servicios .service-group:not(.service-group--secondary) .service-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .service-group--secondary .service-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .principles__grid,.insights__grid,.why-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .principles__grid .principle:last-child,.insights__grid .insight-card:last-child{grid-column:1/-1}
  .footer__grid{grid-template-columns:1fr 1fr!important}.footer__grid>div:first-child{grid-column:1/-1}
}

/* Móvil grande */
@media (max-width:680px){
  .container{width:min(100% - 28px,1180px)!important}
  .topbar{display:none!important}.header__inner{height:68px!important}.site-header.is-scrolled .header__inner{height:62px!important}
  .brand__logo{width:min(205px,58vw)!important;max-height:48px!important}
  .hero{padding:0!important}.hero__grid{padding-top:42px!important;padding-bottom:58px!important}.hero__content h1{font-size:clamp(2.35rem,12.2vw,4rem)!important;line-height:.98!important;letter-spacing:-.055em!important}.hero__content>p{font-size:1rem!important;line-height:1.62!important}.hero__actions{display:grid!important;grid-template-columns:1fr!important}.hero__actions .btn{width:100%!important}.hero__card{padding:28px!important;min-height:300px!important;border-radius:28px!important}.hero__card h2{font-size:clamp(1.8rem,8vw,2.5rem)!important}.hero__card::after{font-size:7rem!important}
  .trust-row{grid-template-columns:1fr 1fr!important;margin-top:34px!important}.trust-row>div{padding:0 12px 14px 0!important;border-right:0!important}.trust-row>div:last-child{grid-column:1/-1!important;border-top:1px solid var(--line)!important;padding-top:14px!important}
  #servicios .service-group:not(.service-group--secondary) .service-grid,.service-group--secondary .service-grid,.principles__grid,.insights__grid,.why-grid{grid-template-columns:1fr!important}
  .principles__grid .principle:last-child,.insights__grid .insight-card:last-child{grid-column:auto!important}
  #servicios .service-group:not(.service-group--secondary) .service-card,#servicios .service-group:not(.service-group--secondary) .service-card:nth-child(n){min-height:auto!important;padding:26px!important}.service-card__number{margin-bottom:28px!important}.service-card h3{margin-top:22px!important}
  .service-group__heading{display:block!important}.service-group__heading p{text-align:left!important;margin-top:8px!important}
  .profile__photo,.profile__photo img{min-height:115vw!important;max-height:620px!important}.profile__photo{border-radius:24px!important;transform:none!important}
  .principle,.insight-card,.why-card{min-height:auto!important;padding:26px!important}.principle ul{columns:1!important}
  .showcase-panel{padding:24px!important;border-radius:24px!important}.showcase-panel__visual{min-height:220px!important;border-radius:20px!important;padding:24px!important}
  .cta__box{display:block!important;padding:32px 26px!important;border-radius:26px!important}.cta__box .btn{width:100%!important;margin-top:24px!important}
  .field-grid{grid-template-columns:1fr!important}.contact-form{padding:22px!important;border-radius:22px!important}
  .contact-list div{grid-template-columns:1fr!important;gap:4px!important}
  .footer{padding-bottom:110px!important}.footer__grid{grid-template-columns:1fr!important;gap:28px!important}.footer__grid>div:first-child{grid-column:auto!important}.footer__logo{width:min(240px,75vw)!important}
  .whatsapp-float{display:none!important}.mobile-actions{display:grid!important}
}

/* Móviles compactos */
@media (max-width:420px){
  .container{width:calc(100% - 22px)!important}
  .hero__content h1{font-size:clamp(2.1rem,11.5vw,3.05rem)!important}.hero__card{padding:24px!important}.hero__card-top{left:24px!important;right:24px!important}
  .btn{min-height:48px!important;padding-inline:16px!important}
  .trust-row{grid-template-columns:1fr!important}.trust-row>div,.trust-row>div:last-child{grid-column:auto!important;border-top:1px solid var(--line)!important;padding:12px 0!important}.trust-row>div:first-child{border-top:0!important}
  .service-card h3{font-size:1.35rem!important}.service-card p{font-size:.95rem!important}
  .mobile-actions{grid-template-columns:1fr 1fr!important;padding-inline:8px!important}.mobile-actions a{font-size:.88rem!important}
}

/* Muy angosto: evita cualquier corte accidental */
@media (max-width:350px){
  .container{width:calc(100% - 16px)!important}.brand__logo{width:165px!important}.menu-toggle{width:40px!important;padding:8px!important}.hero__content h1{font-size:2rem!important}.mobile-actions a{font-size:.8rem!important;padding-inline:4px!important}
}

/* Pantallas grandes / ultrawide: contenido centrado, no estirado */
@media (min-width:1600px){
  .container{width:min(1320px,calc(100% - 120px))!important}.hero__grid{grid-template-columns:minmax(0,1.12fr) minmax(390px,.68fr)!important}.hero__content h1{max-width:980px!important}
}

/* Touch: desactiva inclinaciones que se sienten raras en pantallas táctiles */
@media (hover:none),(pointer:coarse){
  .tilt-card,.hero__card{transform:none!important}.service-card:hover,.btn:hover{transform:none!important}
}


/* V14 — Servicios principales definitivos + cache-safe */
#servicios .service-group:not(.service-group--secondary) .service-grid{
  display:grid!important;
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
  gap:18px!important;
  align-items:stretch!important;
}
#servicios .service-group:not(.service-group--secondary) .service-card,
#servicios .service-group:not(.service-group--secondary) .service-card:nth-child(n){
  grid-column:auto!important;
  grid-row:auto!important;
  min-width:0!important;
  min-height:270px!important;
  height:100%!important;
  background:#fff!important;
  color:var(--ink)!important;
  border:1px solid var(--line)!important;
  border-radius:24px!important;
  padding:30px!important;
  display:flex!important;
  flex-direction:column!important;
  justify-content:flex-start!important;
  backdrop-filter:none!important;
}
#servicios .service-group:not(.service-group--secondary) .service-card:nth-child(n) p{color:var(--muted)!important}
#servicios .service-group:not(.service-group--secondary) .service-card::after{display:none!important}
#servicios .service-group:not(.service-group--secondary) .service-card__number{
  position:static!important;
  display:inline-flex!important;
  width:42px!important;height:42px!important;
  align-items:center!important;justify-content:center!important;
  border-radius:50%!important;background:#fff3f6!important;color:var(--red)!important;
  margin:0 0 34px!important;flex:0 0 auto!important;
}
#servicios .service-group:not(.service-group--secondary) .service-card h3{
  color:var(--ink)!important;margin:auto 0 12px!important;font-size:1.55rem!important;line-height:1.15!important;
}
@media (max-width:980px){
  #servicios .service-group:not(.service-group--secondary) .service-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
}
@media (max-width:680px){
  #servicios .service-group:not(.service-group--secondary) .service-grid{grid-template-columns:1fr!important}
  #servicios .service-group:not(.service-group--secondary) .service-card,
  #servicios .service-group:not(.service-group--secondary) .service-card:nth-child(n){min-height:auto!important;height:auto!important}
}


/* V20 — Fotografía distribuida a lo largo de todo el sitio */
.section-photo{position:relative;overflow:hidden;border-radius:28px;margin:38px 0 50px;min-height:300px;background:#ddd;box-shadow:0 18px 50px rgba(17,18,22,.08)}
.section-photo img{width:100%;height:100%;min-height:300px;object-fit:cover;display:block;filter:saturate(.92) contrast(1.02)}
.section-photo::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(12,12,15,.58) 100%)}
.section-photo span{position:absolute;left:28px;bottom:22px;z-index:2;color:#fff;font-weight:800;font-size:clamp(1rem,1.6vw,1.3rem);letter-spacing:-.02em}
.section-photo--wide{min-height:340px}
.section-photo--wide img{min-height:340px}
.section-photo--compact{min-height:240px}
.section-photo--compact img{min-height:240px}
.section-photo--dark{border:1px solid rgba(255,255,255,.1);box-shadow:none}
.showcase-panel__visual--photo{padding:0!important;overflow:hidden;min-height:320px}
.showcase-panel__visual--photo img{width:100%;height:100%;min-height:320px;object-fit:cover;display:block}
@media(max-width:900px){.section-photo,.section-photo--wide{min-height:260px}.section-photo img,.section-photo--wide img{min-height:260px}.showcase-panel__visual--photo,.showcase-panel__visual--photo img{min-height:260px}}
@media(max-width:640px){.section-photo,.section-photo--wide,.section-photo--compact{min-height:210px;margin:28px 0 34px;border-radius:20px}.section-photo img,.section-photo--wide img,.section-photo--compact img{min-height:210px}.section-photo span{left:18px;bottom:16px;right:18px}.showcase-panel__visual--photo,.showcase-panel__visual--photo img{min-height:220px}}
